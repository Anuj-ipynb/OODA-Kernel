# ================================================================
# OODA-Kernel Configuration & Secret Environment Variables
# ================================================================

# --- Universal LLM Provider Settings ---
# NVIDIA NIMs Example:
LLM_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct

# OpenRouter Example:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# OpenAI Example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Execution & Safety Guardrail Policies ---
OODA_CONTAINER_NAME=ooda-sandbox
SAFETY_RISK_THRESHOLD=0.70
MAX_REMEDIATION_RETRIES=3
